# Supabase Configuration
# Copy this file to .env.local and update with your actual credentials

# ============================================
# OPTION 1: Remote Supabase (Production/Staging) - ACTIVE
# ============================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# OPTION 2: Local Supabase (Development)
# ============================================
# Uncomment these to use local Supabase (default when running npx supabase start)
# Comment out Option 1 above when using local
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Application Mode
VITE_USE_SUPABASE=true

# Feature Flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_GROUPS=true
VITE_ENABLE_RECURRING=true
VITE_ENABLE_MESSAGING=true

# Development
VITE_DEV_MODE=true

# ============================================
# Supabase CLI Configuration (for migrations)
# ============================================
# These are used by Supabase CLI for remote operations
# Not needed for frontend, but useful for db push/pull
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_ACCESS_TOKEN=your-access-token-here

# ============================================
# Notes
# ============================================
# 1. Get your remote credentials from: https://app.supabase.com/project/_/settings/api
# 2. Local anon key is default for local Supabase and doesn't need to change
# 3. Access token is needed for: supabase db push, supabase migration repair, etc.
# 4. Never commit .env.local or .env with real credentials to version control
